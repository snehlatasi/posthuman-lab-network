# ==========================================
# POSTHUMAN LAB NETWORK - ENVIRONMENT CONFIG
# ==========================================

# --- BACKEND (SPRING BOOT) ---
# The port the backend server will listen on
PORT=8080

# H2 File Database connection settings
DB_PATH=./data/posthuman_db
DB_USER=sa
DB_PASS=your_secure_password_here
H2_CONSOLE_ENABLED=true
JPA_SHOW_SQL=true

# Security
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_EMAIL=admin@posthumanlab.org
ADMIN_PASSWORD=replace_with_a_strong_admin_password

# CORS and identity
FRONTEND_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_VERIFY_TOKENS=false

# Media storage
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_FILE_SIZE_BYTES=52428800

# --- FRONTEND (NEXT.JS) ---
# Next.js Port
FRONTEND_PORT=3000

# Base URL for API requests (Next.js client-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8080
