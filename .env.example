# ==========================================
# POSTHUMAN LAB NETWORK - ENVIRONMENT CONFIG
# ==========================================

# --- BACKEND (SPRING BOOT) ---
# The port the backend server will listen on
PORT=8080

# H2 File Database connection settings
DB_PATH=./data/posthuman_db
DB_USER=sa
DB_PASS=your_secure_password_here
H2_CONSOLE_ENABLED=true
JPA_SHOW_SQL=true

# Security
JWT_SECRET=PosthumanLabNetworkProductionJwtSigningKey2026Secure!
ADMIN_EMAIL=posthumanlabnetwork@gmail.com
ADMIN_PASSWORD=AdminSecret123!

# CORS and member authentication
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_WWW_ORIGIN=http://127.0.0.1:3000
MEMBER_AUTH_EXPOSE_OTP=true
MEMBER_AUTH_OTP_TTL_MINUTES=10

# Media storage
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_FILE_SIZE_BYTES=52428800

# --- FRONTEND (NEXT.JS) ---
# Next.js Port
FRONTEND_PORT=3000

# Base URL for API requests (Next.js client-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- RAILWAY / PRODUCTION EXAMPLE ---
# BACKEND:
# SPRING_PROFILES_ACTIVE=railway
# JWT_SECRET=PosthumanLabNetworkProductionJwtSigningKey2026Secure!
# ADMIN_EMAIL=posthumanlabnetwork@gmail.com
# ADMIN_PASSWORD=AdminSecret123!
# FRONTEND_ORIGIN=https://posthumanlabnetwork.online
# FRONTEND_WWW_ORIGIN=https://www.posthumanlabnetwork.online
#
# FRONTEND:
